# Release build image: cross-compiles soju-rs for x86_64 and aarch64, glibc
# and musl, with the native (x86_64) Rust toolchain and Zig as the C
# cross-compiler/linker. No emulation involved.
FROM docker.io/library/rust:1.99.1-trixie

ARG ZIG_VERSION=0.17.0
ARG CARGO_ZIGBUILD_VERSION=0.23.4

RUN apt-get update \
	&& apt-get install -y --no-install-recommends xz-utils ca-certificates cmake \
	&& rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
		| tar -xJ -C /opt \
	&& ln -s "/opt/zig-x86_64-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig \
	&& zig version

RUN rustup target add \
		x86_64-unknown-linux-gnu \
		aarch64-unknown-linux-gnu \
		x86_64-unknown-linux-musl \
		aarch64-unknown-linux-musl \
	&& cargo install --locked "cargo-zigbuild@${CARGO_ZIGBUILD_VERSION}"

WORKDIR /src
