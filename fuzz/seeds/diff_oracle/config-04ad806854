listen ircs://
hostname example.org
title "My bouncer"
tls cert.pem key.pem
db sqlite3 /x.db
message-store db
auth oauth2 https://a
http-origin https://*.e
accept-proxy-ip localhost 10.0.0.1/8
accept-proxy-unix true
